source("function_PackageDependency.R")
PackageDependency(package_list)
package_list = c("Biobase", "data.table", "rnaseqGene", "vsn", "dplyr", "ggplot2", "pheatmap", "RColorBrewer", "PoiClaClu","dendextend","e1071","pROC","gplots","factoextra")
PackageDependency(package_list)
# load counts table from GEO
urld <- "https://www.ncbi.nlm.nih.gov/geo/download/?format=file&type=rnaseq_counts"
path <- paste(urld, "acc=GSE255359", "file=GSE255359_raw_counts_GRCh38.p13_NCBI.tsv.gz", sep="&");
tbl <- as.matrix(data.table::fread(path, header=T, colClasses="integer"), rownames="GeneID")
# load gene annotations
apath <- paste(urld, "type=rnaseq_counts", "file=Human.GRCh38.p13.annot.tsv.gz", sep="&")
annot <- data.table::fread(apath, header=T, quote="", stringsAsFactors=F, data.table=F)
rownames(annot) <- annot$GeneID
View(annot)
View(tbl)
# sample selection
gsms <- paste0("11111111111111111111111111111110000000000000000000",
"00000000000000000000000000000000000000000000000000",
"000000")
sml <- strsplit(gsms, split="")[[1]]
# group membership for samples
gs <- factor(sml)
groups <- make.names(c("cancer_control","cancer_treatment"))
levels(gs) <- groups
sample_info <- data.frame(Group = gs, row.names = colnames(tbl))
View(sample_info)
# prefilter for low count data
table(rowsums(tbl) < 10)
# prefilter for low count data
table(rowSums(tbl) < 10)
# prefilter for low count data
for (i in c(10, 15, 20, 50, 100)) {
table(rowSums(tbl) < i)
}
# prefilter for low count data
for (i in c(10, 15, 20, 50, 100)) {
print(table(rowSums(tbl) < i))
}
rowSums( tbl >= 10 ) >= min(table(gs))
table(rowSums( tbl >= 10 ) >= min(table(gs)))
# prefilter for low count data
for (i in c(10, 15, 20, 50, 100)) {
print(table(rowSums(tbl) < i))
}
table(rowSums( tbl >= 10 ) >= min(table(gs)))
min(table(gs)
)
keep <- rowSums( tbl >= 10 ) >= min(table(gs))
tbl <- tbl[keep, ] # removed all species with counts lower than 31
View(annot)
View(tbl)
ds <- DESeqDataSetFromMatrix(countData=tbl, colData=sample_info, design= ~Group)
library("Biobase")
library("data.table")
library("rnaseqGene")
library("vsn")
library("dplyr")
library("ggplot2")
library("pheatmap")
library("RColorBrewer")
library("PoiClaClu")
library("dendextend")
library("e1071")
library("pROC")
library("gplots")
library("factoextra")
ds <- DESeqDataSetFromMatrix(countData=tbl, colData=sample_info, design= ~Group)
ds <- DESeq(ds, test="Wald", sfType="poscount")
# extract results for top genes table
DEG_results <- results (ds, contrast=c("Group", groups[1], groups[2]), alpha=0.05, pAdjustMethod ="fdr")
table(DEG_results$padj < 0.05)
View(DEG_results)
DEG_view = as.data.frame(DEG_results)
View(DEG_view)
DEG_view = DEG_view[order(DEG_view$padj),]
RNAseqCounts = tbl
rm(tbl)
par(mfrow = c(1,2))
boxplot(RNAseqCounts, las = 3, main = "Raw Counts", col = "grey")
boxplot(log2(RNAseqCounts)+1, las = 3, main = "Raw Counts_Log2 Transformed", col = "grey")
meanSdPlot(as.matrix(RNAseqCounts), ranks = FALSE)
meanSdPlot(as.matrix(log2(RNAseqCounts+1)), ranks = FALSE)
meanSdPlot(as.matrix(RNAseqCounts), ranks = FALSE)
meanSdPlot(as.matrix(log2(RNAseqCounts+1)), ranks = FALSE)
par(mfrow = c(1,2))
boxplot(RNAseqCounts, las = 3, main = "Raw Counts", col = "grey")
boxplot(log2(RNAseqCounts)+1, las = 3, main = "Raw Counts_Log2 Transformed", col = "grey")
meanSdPlot(as.matrix(RNAseqCounts), ranks = FALSE)
meanSdPlot(as.matrix(log2(RNAseqCounts+1)), ranks = FALSE)
ds.vst = varianceStabilizingTransformation(dds, blind = FALSE)
ds.vst = varianceStabilizingTransformation(ds, blind = FALSE)
ds.rlog = rlog(ds, blind = FALSE)
RNAseqCounts.vst = varianceStabilizingTransformation(assay(dds)) # varaince stablization
RNAseqCounts.vst = varianceStabilizingTransformation(assay(ds)) # varaince stablization
RNAseqCounts.rlog = assay(ds.rlog) # regularized log
Inf %in% RNAseqCounts.rlog
RNAseqCounts.rpm = sweep(RNAseqCounts, MARGIN = 2, colSums(RNAseqCounts)/1000000, FUN = "/"); dim(RNAseqCounts.rpm) #reads per million
meanSdPlot(as.matrix(log2(RNAseqCounts.rpm+1)), ranks = FALSE)
meanSdPlot(as.matrix(RNAseqCounts.vst), ranks = FALSE)
meanSdPlot(as.matrix(RNAseqCounts.rlog), ranks = FALSE)
# boxplots
par(mfrow = c(1,2))
boxplot(log2(RNAseqCounts)+1, las = 3, main = "Raw Counts_Log2 Transformed", col = "grey")
boxplot(log2(RNAseqCounts.rpm)+1, las = 3, main = "RPM Counts_Log2 Transformed", col = "lightgreen")
par(mfrow = c(1,2))
boxplot(log2(RNAseqCounts.rpm)+1, las = 3, main = "RPM Counts_Log2 Transformed", col = "lightgreen")
boxplot(RNAseqCounts.vst, las = 3, main = "Variance Stabilized Counts", col = "lightblue")
boxplot(RNAseqCounts.vst, las = 3, main = "Variance Stabilized Counts", col = "lightblue")
boxplot(RNAseqCounts.rlog, las = 3, main = "Regulariszed Logrithm Counts", col = "blue")
par(mfrow = c(2,2))
boxplot(log2(RNAseqCounts)+1, las = 3, main = "Raw Counts_Log2 Transformed", col = "grey")
boxplot(log2(RNAseqCounts.rpm)+1, las = 3, main = "RPM Counts_Log2 Transformed", col = "lightgreen")
boxplot(RNAseqCounts.vst, las = 3, main = "Variance Stabilized Counts", col = "lightblue")
boxplot(RNAseqCounts.rlog, las = 3, main = "Regularized Logrithm Counts", col = "blue")
df <- bind_rows(
as_data_frame(log2(counts(dds, normalized=TRUE)[, 1:2]+1)) %>%
mutate(transformation = "log2(x + 1)"),
as_data_frame(assay(dds.vst)[, 1:2]) %>% mutate(transformation = "vst"),
as_data_frame(assay(dds.rlog)[, 1:2]) %>% mutate(transformation = "rlog"))
df <- bind_rows(
as_data_frame(log2(counts(ds, normalized=TRUE)[, 1:2]+1)) %>%
mutate(transformation = "log2(x + 1)"),
as_data_frame(assay(ds.vst)[, 1:2]) %>% mutate(transformation = "vst"),
as_data_frame(assay(ds.rlog)[, 1:2]) %>% mutate(transformation = "rlog"))
colnames(df)[1:2] <- c("x", "y")
lvls <- c("log2(x + 1)", "vst", "rlog")
df$transformation <- factor(df$transformation, levels=lvls)
ggplot(df, aes(x = x, y = y)) + geom_hex(bins = 80) +
coord_fixed() + facet_grid( . ~ transformation)
variance_check = function (count_data, plot_title = NULL, table_return = FALSE, hist_return = TRUE, scatter_return = FALSE) {
gene.ct = dim(count_data)[1]
temp.df = data.frame(matrix(0, nrow = gene.ct, ncol = 2))
colnames(temp.df) = c("gene_index", "variance")
temp.df[,"gene_index"] = 1:gene.ct
for (gene in 1:gene.ct) {
temp.df[gene, "variance"] = var(c(t(count_data[gene,])))
}
if (table_return == TRUE) {
return(temp.df)
}
if (hist_return == TRUE) {
hist(temp.df[,"variance"], main = plot_title, xlab = "variance")
}
if (scatter_return == TRUE) {
plot(x = temp.df$gene_index, y = temp.df$variance, main = plot_title, xlab = "gene index", ylab = "variance")
}
}
par(mfrow = c(1,2))
variance_check(log2(RNAseqCounts.rpm)+1, plot_title = "RPM Normalized Data", hist_return = TRUE, scatter_return = TRUE)
variance_check(RNAseqCounts.vst, plot_title = "VST Normalized Data", hist_return = TRUE, scatter_return = TRUE)
variance_check(RNAseqCounts.rlog, plot_title = "rlog Normalized Data", hist_return = TRUE, scatter_return = TRUE)
